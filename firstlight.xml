        <item>
            <title>0.2.15</title>
            <pubDate>Mon, 21 Sep 2026 14:12:33 -0700</pubDate>
            <link>https://github.com/serafimcloud/firstlight-releases/releases/tag/0.2.15</link>
            <sparkle:fullReleaseNotesLink>https://github.com/serafimcloud/firstlight-releases/releases</sparkle:fullReleaseNotesLink>
            <sparkle:version>24</sparkle:version>
            <sparkle:shortVersionString>0.2.15</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
            <description sparkle:format="plain-text"><![CDATA[Group invitations now have their own tab, showing who invited you and who is already in the group. Join and Decline update immediately, and invitations are available from both the dashboard and Settings.

The menu bar fits the friends it shows, keeps selection aligned around their avatars, and avoids hover highlights while scrolling.

Improves accessibility for friend codes, keeps cities readable beside long names, and makes profile and tray interactions more stable.
]]></description>
            <enclosure url="https://github.com/serafimcloud/firstlight-releases/releases/download/0.2.15/Firstlight-0.2.15.zip" length="43168600" type="application/octet-stream" sparkle:edSignature="xkF3s4Hd6BFSKC9DgbI0kvIVhQ+f3laUANB8mzN/Pkpo1xbR1IsgL5jogEcnFDfLE3rVe5P8ufGqNHGu4McZBA=="/>
